          - type: template
            baseClass: AnimatedSprite
            name: retryButton
            depth: 0
            texture: 2QWMwH7bJW1Jrt
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  if (pointer.x >= this.x && pointer.x <= this.x + this.width &&
                  pointer.y >= this.y && pointer.y <= this.y + this.height)

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 432, 144);
                      if (pointer.down[0] && pointer.buttons == 1 && inputEnabled && this.requestedAlpha > 0)
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 480, 160);

                      if (pointer.released[0] && pointer.buttons == 1 && inputEnabled && this.requestedAlpha > 0)
                      {
                          for (let i = 0; i < templates.list.zack.length; i++)
                          {
                              if (!templates.list.zack[i]) 
                                  continue;

                              templates.list.zack[i].deathTicks = 0;
                              templates.list.zack[i].requestedAlpha = 1;
                              templates.list.zack[i].alpha = 1;
                              templates.list.zack[i].tick = 0;
                              templates.list.zack[i].blinking = false;
                              templates.list.zack[i].idleTick = 0;

                              templates.list.zack[i].respawnTick = 45;
                              templates.list.zack[i].tex = "zack_idle";

                              currentLevelPoints = 0;
                              templates.list.zack[i].ResetLevel();

                              for (let j = 0; j < templates.list.target.length; j++)
                              {
                                  if (!templates.list.target[j]) 
                                      continue;

                                  templates.list.target[j].RestartTarget(i);
                              }
                          }

                          currentLevelComplete = false;
                          this.alpha = 0;
                          this.requestedAlpha = 0;

                          StopSFX();
                          sounds.play("select", { volume: sfxVolume } );

                          for (let i = 0; i < templates.list.theFlag.length; i++) 
                          { 
                              templates.list.theFlag[i].frame = 1;
                              templates.list.theFlag[i].frameTick = 0;
                              templates.list.theFlag[i].tex = "theFlag_frame1";
                          }

                          for (let i = 0; i < templates.list.cloudBG.length; i++)
                          {
                              if (!templates.list.cloudBG[i]) 
                                  continue;

                              templates.list.cloudBG[i].x = templates.list.cloudBG[i].startX;
                          }

                          if (templates.list.resumeButton)
                          {
                              for (let i = 0; i < templates.list.resumeButton.length; i++)
                              {
                                  if (!templates.list.resumeButton[i]) 
                                      continue;

                                  templates.list.resumeButton[i].alpha = 0;
                                  templates.list.resumeButton[i].requestedAlpha = 0;
                              }
                          }

                          
                          if (templates.list.toMenuButton)
                          {
                              for (let i = 0; i < templates.list.toMenuButton.length; i++)
                              {
                                  if (!templates.list.toMenuButton[i]) 
                                      continue;

                                  templates.list.toMenuButton[i].alpha = 0;
                                  templates.list.toMenuButton[i].requestedAlpha = 0;
                              }
                          }

                          if (templates.list.blackBG)
                          {
                              for (let i = 0; i < templates.list.blackBG.length; i++)
                              {
                                  if (!templates.list.blackBG[i]) 
                                      continue;

                                  templates.list.blackBG[i].alpha = 0;
                                  templates.list.blackBG[i].requestedAlpha = 0;
                              }
                          }

                          if (templates.list.blackBGText)
                          {
                              for (let i = 0; i < templates.list.blackBGText.length; i++)
                              {
                                  if (!templates.list.blackBGText[i]) 
                                      continue;

                                  if (!currentLevelComplete)
                                  {
                                      templates.list.blackBGText[i].newText = "Paused";
                                  }
                                  else
                                  {
                                      templates.list.blackBGText[i].newText = "Level Complete!";
                                  }    

                                  templates.list.blackBGText[i].alpha = 0;
                                  templates.list.blackBGText[i].requestedAlpha = 0;
                                  templates.list.blackBGText[i].requestedAlpha = 0;
                              }
                          }
                      }
                  }

                  else

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 384, 128);
                  }


                  this.x = camera.x - (this.width / 2) + this.requestedXOffset;

                  this.y = camera.y - (this.height / 2) + this.requestedYOffset;
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.requestedAlpha = 0;
                  this.requestedXOffset = 0;
                  this.requestedYOffset = 0;
                  this.zIndex = 10;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: |-
                  this.alpha = this.requestedAlpha;

                  this.x = camera.x - (this.width / 2) + this.requestedXOffset;
                  this.y = camera.y - (this.height / 2) + this.requestedYOffset;
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
