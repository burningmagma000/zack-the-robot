startroom: tG1PFq6Pc6cc1K
contentTypes: []
actions:
  - name: Mute
    methods:
      - code: keyboard.KeyM
  - name: PlayerLeft
    methods:
      - code: keyboard.KeyA
      - code: keyboard.ArrowLeft
  - name: PlayerRight
    methods:
      - code: keyboard.ArrowRight
      - code: keyboard.KeyD
  - name: PlayerJump
    methods:
      - code: keyboard.KeyW
      - code: keyboard.Space
      - code: keyboard.ArrowUp
  - name: Reset
    methods:
      - code: keyboard.KeyR
  - name: Pause
    methods:
      - code: keyboard.KeyP
scripts:
  - name: Functions
    code: |-
      let hasLoggedInBefore = false;
      var songPlaying = false;
      var inputEnabled = true;
      var volumeIsMuted = false;
      var preferredMusicVolume = 1;
      var preferredSFXVolume = 1;
      var circleOutTimeInMS = 1000;
      var levelsUnlocked = 1;
      var timesMainMenuOpened = 0;
      var timesLevelOpened = 0;
      var currentLevelPoints = 0;
      var levelPointsFinished = 0;
      var touchingHazard = false;
      var totalScore = 0;
      var pointsLvl1 = 0;
      var pointsLvl2 = 0;
      var pointsLvl3 = 0;
      var pointsLvl4 = 0;
      var pointsLvl5 = 0;
      var pointsLvl6 = 0;
      var pointsLvl7 = 0;
      var pointsLvl8 = 0;
      var pointsLvl9 = 0;
      var pointsLvl10 = 0;
      var currentLevelComplete = false;
      var musicVolume = preferredMusicVolume;
      var sfxVolume = preferredSFXVolume;

      function Scale(object, centerX, centerY, pixelWidth, pixelHeight)
      {
          object.width = pixelWidth;
          object.height = pixelHeight;
          object.x = centerX - (object.width / 2);
          object.y = centerY - (object.height / 2);
      }

      function PlaySong()
      {
          sounds.play("songLoop", { loop: true, volume: 1 });
          UpdateVolume();
          songPlaying = true;
      }

      function MuteUnmute()
      {
          if (volumeIsMuted)
              volumeIsMuted = false;
          else
              volumeIsMuted = true;
          
          UpdateVolume();
      }

      function UpdateVolume()
      {
          if (!volumeIsMuted)
          {
              musicVolume = preferredMusicVolume;
              sfxVolume = preferredSFXVolume;
          }
          else
          {
              musicVolume = 0;
              sfxVolume = 0;
          }
          
          // Music
          sounds.volume("songLoop", musicVolume);

          // SFX
          sounds.volume("startupSound", sfxVolume);
          sounds.volume("select", sfxVolume);
          sounds.volume("roomEnterSFX", sfxVolume);
          sounds.volume("playerDeath", sfxVolume);
          sounds.volume("playerJump", sfxVolume);
          sounds.volume("playerHitHead", sfxVolume);
          sounds.volume("coinCollect", sfxVolume);
          sounds.volume("victory", sfxVolume);
          sounds.volume("shot", sfxVolume);
      }

      function StopSFX()
      {
          sounds.stop("startupSound");
          sounds.stop("select");
          sounds.stop("roomEnterSFX");
          sounds.stop("playerDeath");
          sounds.stop("playerJump");
          sounds.stop("playerHitHead");
          sounds.stop("coinCollect");
          sounds.stop("victory");
          sounds.stop("alarm");
          sounds.stop("shot");
      }

      function InView(obj)
      {
          return !(obj.x + obj.width < camera.x - 1920 || obj.x > camera.x + 1920 || obj.y + obj.height < camera.y - 1080 || obj.y > camera.y + 1080);
      }

      function UnlockLevelAndUpdatePoints()
      {
          if (rooms.current.name == "Level1")
          {
              if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO && globalThis.NGIO.hasUser)
              {
                  globalThis.NGIO.unlockMedal(90406, null, null);
              }
              
              if (levelsUnlocked <= 1)
                  levelsUnlocked = 2;

              if (currentLevelPoints > pointsLvl1)
              {
                  pointsLvl1 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level2")
          {
              if (levelsUnlocked <= 2)
                  levelsUnlocked = 3;

              if (currentLevelPoints > pointsLvl2)
              {
                  pointsLvl2 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level3")
          {
              if (levelsUnlocked <= 3)
                  levelsUnlocked = 4;

              if (currentLevelPoints > pointsLvl3)
              {
                  pointsLvl3 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level4")
          {
              if (levelsUnlocked <= 4)
                  levelsUnlocked = 5;

              if (currentLevelPoints > pointsLvl4)
              {
                  pointsLvl4 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level5")
          {
              if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO && globalThis.NGIO.hasUser)
              {
                  globalThis.NGIO.unlockMedal(90407, null, null);
              }
              
              if (levelsUnlocked <= 5)
                  levelsUnlocked = 6;

              if (currentLevelPoints > pointsLvl5)
              {
                  pointsLvl5 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level6")
          {
              if (levelsUnlocked <= 6)
                  levelsUnlocked = 7;

              if (currentLevelPoints > pointsLvl6)
              {
                  pointsLvl6 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level7")
          {
              if (levelsUnlocked <= 7)
                  levelsUnlocked = 8;

              if (currentLevelPoints > pointsLvl7)
              {
                  pointsLvl7 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level8")
          {
              if (levelsUnlocked <= 8)
                  levelsUnlocked = 9;

              if (currentLevelPoints > pointsLvl8)
              {
                  pointsLvl8 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level9")
          {
              if (levelsUnlocked <= 9)
                  levelsUnlocked = 10;

              if (currentLevelPoints > pointsLvl9)
              {
                  pointsLvl9 = currentLevelPoints;
              }
          }

          if (rooms.current.name == "Level10")
          {
              if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO && globalThis.NGIO.hasUser)
              {
                  globalThis.NGIO.unlockMedal(90408, null, null);
              }
              
              if (currentLevelPoints > pointsLvl10)
              {
                  pointsLvl10 = currentLevelPoints;
              }
          }
          
          totalScore = pointsLvl1 + pointsLvl2 + pointsLvl3 + pointsLvl4 + pointsLvl5 + pointsLvl6 + pointsLvl7 + pointsLvl8 + pointsLvl9 + pointsLvl10;
          currentLevelPoints = 0;
      }
