          - type: template
            baseClass: AnimatedSprite
            name: levelButton_1
            depth: 0
            texture: QqLP2zKK7BTRpt
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (levelsUnlocked >= 1)
                  {
                      this.tex = "levelButton_1";
                      if (pointer.x >= this.x && pointer.x <= this.x + this.width && pointer.y >= this.y && pointer.y <= this.y + this.height)
                      {
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 144, 144);
                          if (pointer.down[0] && pointer.buttons == 1 && inputEnabled)
                              Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 160, 160);

                          if (pointer.released[0] && pointer.buttons == 1 && inputEnabled)
                          {
                              sounds.play("roomEnterSFX"); // Transition SFX plays

                              transition.circleOut(circleOutTimeInMS, 0x000000).then(() => { rooms.switch("Level1"); });

                              inputEnabled = false;
                          }
                      }
                      else
                      {
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 128, 128);
                      }
                  }
                  else
                  {
                      this.tex = "lockedButton";
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
            lastmod: 1779949798098
            uid: LFThbDwP7LQN4c
            behaviors: []
            extendTypes: ''
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
          - type: template
            baseClass: NineSlicePlane
            name: backButtonU
            depth: 0
            texture: TGHL31Qb98QwCB
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  // Calculating the distance between the center of the button &
                  the mouse pointer

                  let distance = Math.sqrt(Math.pow((this.x + (this.width / 2) -
                  pointer.x), 2) + Math.pow((this.y + (this.height / 2) -
                  pointer.y), 2));


                  if (distance <= this.width / 2)

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 144, 144);
                      if (pointer.down[0] && pointer.buttons == 1 && inputEnabled)
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 160, 160);

                      if (pointer.released[0] && pointer.buttons == 1 && inputEnabled)
                      {
                          sounds.play("select"); // Select SFX plays

                          if (rooms.current.everything != undefined) // Calling on the MoveCameraUp() function from CAMERA 
                          {
                              for (let i = 0; i < rooms.current.everything.children.length; i++) 
                              {
                                  let obj = rooms.current.everything.children[i] as any;
                                  if (obj.MoveCameraUp != undefined) 
                                  {
                                      obj.movingUpByARoom = true;
                                      break;
                                  }
                              }
                          }

                          inputEnabled = false;
                      }
                  }

                  else

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 128, 128);
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779949770803
            uid: DL6tTDGzfdrpPB
            behaviors: []
            extendTypes: ''
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
