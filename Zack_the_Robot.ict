                depth: 0
                texture: kmFhnC77L2ktWh
                playAnimationOnStart: true
                loopAnimation: true
                animationFPS: 60
                visible: true
                events:
                  - eventKey: OnCreate
                    code: |-
                      this.alpha = 0;
                      this.y -= 8192;
                      this.zIndex = -9;
                      this.startX = this.x;
                    arguments: {}
                    lib: core
                  - eventKey: OnDraw
                    code: |-
                      this.alpha = 0.5;

                      if (this.startX == undefined)
                      {
                          this.startX = this.x;
                      }


                      for (let i = 0; i < templates.list.zack.length; i++)
                      {
                          if (!templates.list.zack[i]) 
                              continue;
                          
                          if (templates.list.zack[i].allowedToMove)
                              this.x -= 2;

                          if (this.x <= this.startX - 4096 || templates.list.zack[i].respawnTick == 45 || ((!templates.list.zack[i].deathTicks || templates.list.zack[i].deathTicks <= 0) && actions.Reset.pressed && inputEnabled && !currentLevelComplete && templates.list.zack[i].allowedToMove))
                          {
                              this.x = this.startX;
                          }

                      }
                    arguments: {}
                    lib: core
                extends:
