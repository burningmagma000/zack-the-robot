                      if (currentLevelPoints > pointsLvl7)
                      {
                          newText = "Total Score: " + (totalScore - pointsLvl7 + currentLevelPoints).toLocaleString();
                      }
                      if (currentLevelPoints <= pointsLvl7)
                      {
                          newText = "Total Score: " + totalScore.toLocaleString();
                      }
                  }

                  if (rooms.current.name == "Level8")
                  {
                      if (currentLevelPoints > pointsLvl8)
                      {
                          newText = "Total Score: " + (totalScore - pointsLvl8 + currentLevelPoints).toLocaleString();
                      }
                      if (currentLevelPoints <= pointsLvl8)
                      {
                          newText = "Total Score: " + totalScore.toLocaleString();
                      }
                  }

                  if (rooms.current.name == "Level9")
                  {
                      if (currentLevelPoints > pointsLvl9)
                      {
                          newText = "Total Score: " + (totalScore - pointsLvl9 + currentLevelPoints).toLocaleString();
                      }
                      if (currentLevelPoints <= pointsLvl9)
                      {
                          newText = "Total Score: " + totalScore.toLocaleString();
                      }
                  }

                  if (rooms.current.name == "Level10")
                  {
                      if (currentLevelPoints > pointsLvl10)
                      {
                          newText = "Total Score: " + (totalScore - pointsLvl10 + currentLevelPoints).toLocaleString();
                      }
                      if (currentLevelPoints <= pointsLvl10)
                      {
                          newText = "Total Score: " + totalScore.toLocaleString();
                      }
                  }

                  if (newText != this.lastText)
                  {
                      this.lastText = newText;

                      this.label.text = newText;

                      this.label.x = 0;
                      this.label.y = 0;

                      for (let i = 0; i < this.outlines.length; i++)
                      {
                          const o = this.outlines[i];

                          o.obj.text = newText;

                          o.obj.x = this.label.x + o.offset[0];
                          o.obj.y = this.label.y + o.offset[1];
                      }
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.requestedAlpha = 1;
                  this.requestedXOffset = 24;
                  this.requestedYOffset = 64;
                  this.zIndex = 11;
                  this.newText = "";
                  this.animationStopped = false;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.tick == undefined)

                  {
                      this.tick = 0;
                  }


                  this.alpha = 1;


                  this.x = camera.x - (camera.width / 2) +
                  this.requestedXOffset;

                  this.y = camera.y - (camera.height / 2) +
                  this.requestedYOffset;
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779993120248
            uid: cKMMqDtB3T4CFb
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: AnimatedSprite
            name: HighScoreDisplay
            depth: 0
            texture: -1
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  if (!this.label)

                  {
                      this.text = "";
                      this.lastText = "";

                      this.label = new PIXI.BitmapText("",
                      {
                          align: "center",
                          fontName: "Ithaca",
                          fontSize: 64
                      });

                      this.addChild(this.label);

                      this.outlines = [];

                      const outline = 4;

                      const offsets =
                      [
                          [-outline, -outline],
                          [0, -outline],
                          [outline, -outline],
                          [outline, 0],
                          [outline, outline],
                          [0, outline],
                          [-outline, outline],
                          [-outline, 0]
                      ];

                      for (let i = 0; i < offsets.length; i++)
                      {
                          const outlineText = new PIXI.BitmapText("",
                          {
                              align: "center",
                              fontName: "Ithaca",
                              fontSize: 64
                          });

                          outlineText.tint = 0x000000;

                          this.addChildAt(outlineText, 0);

                          this.outlines.push(
                          {
                              obj: outlineText,
                              offset: offsets[i]
                          });
                      }
                  }


                  const newText = "Your total score: " +
                  totalScore.toLocaleString();


                  if (newText != this.lastText)

                  {
                      this.lastText = newText;

                      this.label.text = newText;

                      this.label.x = -this.label.width / 2;
                      this.label.y = -this.label.height / 2;

                      for (let i = 0; i < this.outlines.length; i++)
                      {
                          const o = this.outlines[i];

                          o.obj.text = newText;

                          o.obj.x = this.label.x + o.offset[0];
                          o.obj.y = this.label.y + o.offset[1];
                      }
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1780005496334
            uid: qd8FdCmgjCCKqf
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: NineSlicePlane
            name: logInOutButton
            depth: 0
            texture: gj7GgdMW6D8ptn
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO)

                  {
                      if (globalThis.NGIO.hasUser)
                      {
                          if (!hasLoggedInBefore)
                          {
                              if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO && globalThis.NGIO.hasUser)
                              {
                                  globalThis.NGIO.unlockMedal(89935, null, null);
                              }

                              hasLoggedInBefore = true;
                          }
                      }
                  }


                  // Calculating the distance between the center of the button &
                  the mouse pointer

                  let distance = Math.sqrt(Math.pow((this.x + (this.width / 2) -
                  pointer.x), 2) + Math.pow((this.y + (this.height / 2) -
                  pointer.y), 2));


                  if (distance <= this.width / 2)

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 144, 144);
                      if (pointer.down[0] && pointer.buttons == 1 && inputEnabled)
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 160, 160);

                      if (pointer.released[0] && pointer.buttons == 1 && inputEnabled)
                      {
                          sounds.play("select"); // Select SFX plays
                          
                          if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO)
                          {
                              if (!globalThis.NGIO.hasUser)
                              {
                                  if (hasLoggedInBefore)
                                  {
                                      if (!globalThis.NGIO.loginPageOpen)
                                      {
                                          globalThis.NGIO.cancelLogin();
                                          globalThis.NGIO.skipLogin();
                                          globalThis.NGIO.openLoginPage();
                                      }
                                  }
                                  else
                                  {
                                      globalThis.NGIO.getConnectionStatus(function(status)
                                      {
                                          switch (status)
                                          {    
                                              case globalThis.NGIO.STATUS_LOGIN_REQUIRED:
                                                  if (!globalThis.NGIO.loginPageOpen)
                                                  {
                                                      globalThis.NGIO.openLoginPage();
                                                  }
                                                  else
                                                  {
                                                      globalThis.NGIO.skipLogin();
                                                  }
                                              break;
                                          }
                                      });
                                  }
                              }
                              else
                              {
                                  globalThis.NGIO.logOut();
                              }
                          }
                      }
                  }

                  else

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 128, 128);
                  }


                  if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO)

                  {
                      if (globalThis.NGIO.hasUser)
                          this.tex = "logOutButton";
                      else
                          this.tex = "logInButton";
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1780180904374
            uid: 7m34GqtR95bDCQ
            behaviors: []
            extendTypes: ''
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
