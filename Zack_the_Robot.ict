          - type: folder
            uid: M28CpHW1zPn17r
            colorClass: act
            icon: help-circle
            name: sprites
            lastmod: 1779658819999
            entries:
              - type: template
                baseClass: AnimatedSprite
                name: zack
                depth: 0
                texture: h1ggptFDD3qtFG
                playAnimationOnStart: true
                loopAnimation: false
                animationFPS: 60
                visible: true
                events:
                  - eventKey: OnStep
                    lib: core
                    code: >-
                      this.SpawnCoordinates = function ()

                      {
                          if (rooms.current.name == "Level1")
                          {
                              this.x = 320;
                              this.y = 3840;
                          }

                          if (rooms.current.name == "Level2")
                          {
                              this.x = 896;
                              this.y = 3456;
                          }

                          if (rooms.current.name == "Level3")
                          {
                              this.x = 384;
                              this.y = 3904;
                          }

                          if (rooms.current.name == "Level4")
                          {
                              this.x = 192;
                              this.y = 3776;
                          }

                          if (rooms.current.name == "Level5")
                          {
                              this.x = 512;
                              this.y = 3520;
                          }

                          if (rooms.current.name == "Level6")
                          {
                              this.x = 384;
                              this.y = 3712;
                          }

                          if (rooms.current.name == "Level7")
                          {
                              this.x = 448;
                              this.y = 3200;
                          }

                          if (rooms.current.name == "Level8")
                          {
                              this.x = 320;
                              this.y = 3584;
                          }

                          if (rooms.current.name == "Level9")
                          {
                              this.x = 448;
                              this.y = 3648;
                          }

                          if (rooms.current.name == "Level10")
                          {
                              this.x = 256;
                              this.y = 3840;
                          }
                      }


                      if (templates.list.resumeButton)

                      {
                          for (let i = 0; i < templates.list.resumeButton.length; i++)
                          {
                              if (!templates.list.resumeButton[i]) 
                                  continue;
                              
                              if (!this.allowedToMove && templates.list.resumeButton[i].alpha == 0)
                              {
                                  this.allowedToMove = true;

                                  this.resetting = true;
                              }
                          }
                      }


                      if (this.allowedToMove && !currentLevelComplete)

                      {
                          for (let i = 0; i < templates.list.blackBG.length; i++)
                          {
                              if (!templates.list.blackBG[i]) 
                                  continue;

                              templates.list.blackBG[i].alpha = 0;
                              templates.list.blackBG[i].requestedAlpha = 0;
                          }
                      }


                      touchingHazard = false;


                      if (this.fallSpeedLimit == undefined)
                          this.fallSpeedLimit = 30;

                      if (this.resetting == undefined)
                          this.resetting = true;

                      if (this.hitHeadPlayed == undefined)

                      {
                          this.hitHeadPlayed = false;
                      }


                      if (actions.Pause.pressed && inputEnabled &&
                      !currentLevelComplete)

                      {
                          if (this.allowedToMove)
                          {
                              StopSFX();
                          }

                          this.allowedToMove = false;
                          
                          if (templates.list.press_p_to_pause_text)
                          {
                              for (let i = 0; i < templates.list.press_p_to_pause_text.length; i++)
                              {
                                  if (!templates.list.press_p_to_pause_text[i]) 
                                      continue;

                                  templates.list.press_p_to_pause_text[i].animationStopped = true;
                                  templates.list.press_p_to_pause_text[i].alpha = 0;
                                  templates.list.press_p_to_pause_text[i].requestedAlpha = 0;
                              }
                          }

                          for (let i = 0; i < templates.list.resumeButton.length; i++)
                          {
                              if (!templates.list.resumeButton[i]) 
                                  continue;

                              templates.list.resumeButton[i].alpha = 1;
                              templates.list.resumeButton[i].requestedAlpha = 1;

                              templates.list.resumeButton[i].requestedXOffset = 0;
                              templates.list.resumeButton[i].requestedYOffset = 0;
                          }

                          for (let i = 0; i < templates.list.retryButton.length; i++)
                          {
                              if (!templates.list.retryButton[i]) 
                                  continue;

                              templates.list.retryButton[i].alpha = 1;
                              templates.list.retryButton[i].requestedAlpha = 1;
                              
                              templates.list.retryButton[i].requestedXOffset = -512;
                              templates.list.retryButton[i].requestedYOffset = 0;
                          }

                          for (let i = 0; i < templates.list.toMenuButton.length; i++)
                          {
                              if (!templates.list.toMenuButton[i]) 
                                  continue;

                              templates.list.toMenuButton[i].alpha = 1;
                              templates.list.toMenuButton[i].requestedAlpha = 1;

                              templates.list.toMenuButton[i].requestedXOffset = 512;
                              templates.list.toMenuButton[i].requestedYOffset = 0;
                          }

                          for (let i = 0; i < templates.list.blackBG.length; i++)
                          {
                              if (!templates.list.blackBG[i]) 
                                  continue;

                              templates.list.blackBG[i].alpha = 0.2;
                              templates.list.blackBG[i].requestedAlpha = 0.2;
                          }

                          for (let i = 0; i < templates.list.blackBGText.length; i++)
                          {
                              if (!templates.list.blackBGText[i]) 
                                  continue;

                              if (!currentLevelComplete)
                              {
                                  templates.list.blackBGText[i].newText = "Paused";
                              }
                              else
                              {
                                  templates.list.blackBGText[i].newText = "Level Complete!";
                              }

                              templates.list.blackBGText[i].alpha = 1;
                              templates.list.blackBGText[i].requestedAlpha = 1;
                          }
                      }


                      for (let i = 0; i < templates.list.theFlag.length; i++)

                      {
                          if (!templates.list.theFlag[i]) 
                              continue;

                          if (!currentLevelComplete && this.x < templates.list.theFlag[i].x + templates.list.theFlag[i].width && this.x + this.width > templates.list.theFlag[i].x && this.y < templates.list.theFlag[i].y + templates.list.theFlag[i].height && this.y + this.height > templates.list.theFlag[i].y)
                          {
                              this.xVel = 0;
                              this.yVel = 0;
                              this.requestedAlpha = 0;
                              this.alpha = 0;
                              this.tex = "zack_idle";
                              StopSFX();
                              sounds.play("victory");

                              levelPointsFinished = currentLevelPoints;

                              UnlockLevelAndUpdatePoints();

                              currentLevelComplete = true;

                              for (let j = 0; j < templates.list.target.length; j++)
                              {
                                  if (!templates.list.target[j]) 
                                      continue;

                                  templates.list.target[j].RestartTarget(0);
                              }
                              

                              if (templates.list.press_p_to_pause_text)
                              {
                                  for (let i = 0; i < templates.list.press_p_to_pause_text.length; i++)
                                  {
                                      if (!templates.list.press_p_to_pause_text[i]) 
                                          continue;

                                      templates.list.press_p_to_pause_text[i].animationStopped = true;
                                      templates.list.press_p_to_pause_text[i].alpha = 0;
                                      templates.list.press_p_to_pause_text[i].requestedAlpha = 0;
                                  }
                              }

                              for (let i = 0; i < templates.list.blackBG.length; i++)
                              {
                                  if (!templates.list.blackBG[i]) 
                                      continue;

                                  templates.list.blackBG[i].alpha = 0.2;
                                  templates.list.blackBG[i].requestedAlpha = 0.2;
                              }

                              for (let i = 0; i < templates.list.retryButton.length; i++)
                              {
                                  if (!templates.list.retryButton[i]) 
                                      continue;

                                  templates.list.retryButton[i].alpha = 1;
                                  templates.list.retryButton[i].requestedAlpha = 1;

                                  templates.list.retryButton[i].requestedXOffset = -256;
                                  templates.list.retryButton[i].requestedYOffset = 0;
                              }

                              for (let i = 0; i < templates.list.toMenuButton.length; i++)
                              {
                                  if (!templates.list.toMenuButton[i]) 
                                      continue;

                                  templates.list.toMenuButton[i].alpha = 1;
                                  templates.list.toMenuButton[i].requestedAlpha = 1;

                                  templates.list.toMenuButton[i].requestedXOffset = 256;
                                  templates.list.toMenuButton[i].requestedYOffset = 0;
                              }

                              for (let i = 0; i < templates.list.blackBGText.length; i++)
                              {
                                  if (!templates.list.blackBGText[i]) 
                                      continue;

                                  if (!currentLevelComplete)
                                  {
                                      templates.list.blackBGText[i].newText = "Paused";
                                  }
                                  else
                                  {
                                      templates.list.blackBGText[i].newText = "Level Complete!";
                                  }

                                  templates.list.blackBGText[i].alpha = 1;
                                  templates.list.blackBGText[i].requestedAlpha = 1;
                              }
                          }
                      }


                      let hazardTile = ["spike_left", "spike_right", "spike_up",
                      "spike_down"];


                      for (let i = 0; i < hazardTile.length; i++)

                      {
                          if (!templates.list[hazardTile[i]])
                              continue;

                          for (let j = 0; j < templates.list[hazardTile[i]].length; j++)
                          {
                              if (!templates.list[hazardTile[i]][j])
                                  continue;

                              if (!InView(templates.list[hazardTile[i]][j]))
                                  continue;
                                  
                              if (hazardTile[i] == "spike_up")
                              {
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width && this.x + this.width > templates.list[hazardTile[i]][j].x && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height && this.y + this.height > templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height - 1)
                                  {
                                      touchingHazard = true;
                                  }
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.6 && this.x + this.width > templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.4 && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.5 && this.y + this.height > templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.2)
                                  {
                                      touchingHazard = true;
                                  }
                              }

                              if (hazardTile[i] == "spike_down")
                              {
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width && this.x + this.width > templates.list[hazardTile[i]][j].x && this.y < templates.list[hazardTile[i]][j].y + 1 && this.y + this.height > templates.list[hazardTile[i]][j].y)
                                  {
                                      touchingHazard = true;
                                  }
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.6 && this.x + this.width > templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.4 && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.8 && this.y + this.height > templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.5)
                                  {
                                      touchingHazard = true;
                                  }
                              }

                              if (hazardTile[i] == "spike_left")
                              {
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width && this.x + this.width > templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width - 1 && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height && this.y + this.height > templates.list[hazardTile[i]][j].y)
                                  {
                                      touchingHazard = true;
                                  }
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.5 && this.x + this.width > templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.2 && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.6 && this.y + this.height > templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.4)
                                  {
                                      touchingHazard = true;
                                  }
                              }

                              if (hazardTile[i] == "spike_right")
                              {
                                  if (this.x < templates.list[hazardTile[i]][j].x + 1 && this.x + this.width > templates.list[hazardTile[i]][j].x && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height && this.y + this.height > templates.list[hazardTile[i]][j].y)
                                  {
                                      touchingHazard = true;
                                  }
                                  if (this.x < templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.8 && this.x + this.width > templates.list[hazardTile[i]][j].x + templates.list[hazardTile[i]][j].width * 0.5 && this.y < templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.6 && this.y + this.height > templates.list[hazardTile[i]][j].y + templates.list[hazardTile[i]][j].height * 0.4)
                                  {
                                      touchingHazard = true;
                                  }
                              }

                              if (touchingHazard && (!this.deathTicks || this.deathTicks <= 0))
                              {
                                  this.deathTicks = 30;
                                  this.requestedAlpha = 1;
                                  this.tex = "zack_death";
                                  this.xVel = 0;
                                  this.yVel = 0;
                                  StopSFX();
                                  if (!sounds.playing("playerDeath"))
                                  {
                                      sounds.play("playerDeath");
                                  }
                              }
                          }
                      }


                      for (let i = 0; i < templates.list.coin.length; i++)

                      {
                          if (!templates.list.coin[i])
                              continue;

                          if (!InView(templates.list.coin[i]))
                              continue;

                          if ((((this.x + this.width / 2) - (templates.list.coin[i].x + 32)) * ((this.x + this.width / 2) - (templates.list.coin[i].x + 32))) + (((this.y + this.height / 2) - (templates.list.coin[i].y + 32)) * ((this.y + this.height / 2) - (templates.list.coin[i].y + 32))) <= 2704 && templates.list.coin[i].requestedAlpha > 0)
                          {
                              templates.list.coin[i].alpha = 0;
                              templates.list.coin[i].requestedAlpha = 0;
                              templates.list.coin[i].frame = 1;
                              templates.list.coin[i].frameTick = 0;
                              templates.list.coin[i].tex = "coin_frame1";

                              currentLevelPoints += 1;

                              if (sounds.playing("coinCollect"))
                              {
                                  sounds.stop("coinCollect");
                              }
                              
                              sounds.play("coinCollect");
                          }
                      }




                      this.ResetLevel = function ()

                      {
                          currentLevelPoints = 0;
                          
                          this.SpawnCoordinates();

                          this.xVel = 0;
                          this.yVel = 0;
                          this.tick = 0;
                          this.blinking = false;
                          this.idleTick = 0;

                          this.resetting = true;
                          this.respawnTick = 45;
                          this.requestedAlpha = 1;
                          this.tex = "zack_idle";


                          for (let i = 0; i < templates.list.cloudBG.length; i++)
                          {
                              if (!templates.list.cloudBG[i]) 
                                  continue;

                              templates.list.cloudBG[i].x = templates.list.cloudBG[i].startX;
                          }

                          for (let i = 0; i < templates.list.coin.length; i++)
                          {
                              if (!templates.list.coin[i])
                                  continue;

                              templates.list.coin[i].alpha = 1;
                              templates.list.coin[i].requestedAlpha = 1;
                              templates.list.coin[i].frame = 1;
                              templates.list.coin[i].frameTick = 0;
                              templates.list.coin[i].tex = "coin_frame1"; 
                          }

                          if (templates.list.CAMERA)
                          {
                              for (let i = 0; i < templates.list.CAMERA.length; i++)
                              {
                                  if (!templates.list.CAMERA[i]) 
                                      continue;

                                  templates.list.CAMERA[i].x = this.x + (this.width / 2);;
                                  templates.list.CAMERA[i].y = this.y + (this.height / 2);
                              }
                          }

                          if (templates.list.target)
                          {
                              for (let i = 0; i < templates.list.target.length; i++)
                              {
                                  if (!templates.list.target[i]) 
                                      continue;

                                  templates.list.target[i].RestartTarget(0);
                              }
                          }

                          StopSFX();
                      }



                      // When the player respawns

                      if ((!this.deathTicks || this.deathTicks <= 0) &&
                      ((actions.Reset.pressed && inputEnabled &&
                      !currentLevelComplete && this.allowedToMove) || this.y >=
                      4096))

                      {
                          this.ResetLevel();
                      }


                      if (this.resetting)

                      {
                          if (!actions.PlayerLeft.value && !actions.PlayerRight.value && !actions.PlayerJump.value)
                              this.resetting = false;

                          actions.PlayerLeft.value = 0;
                          actions.PlayerRight.value = 0;
                          actions.PlayerJump.value = 0;
                      }


                      if (this.deathTicks && this.deathTicks > 0)

                      {
                          if (this.allowedToMove)
                          {
                              sounds.resume("playerDeath");

                              if (this.requestedAlpha == undefined)
                              {
                                  this.requestedAlpha = 1;
                              }

                              if (this.deathTicks > 15)
                              {
                                  this.requestedAlpha -= 1 / 15;
                                  if (this.requestedAlpha < 0)
                                  {
                                      this.requestedAlpha = 0;
                                  }
                              }

                              this.deathTicks--;

                              actions.PlayerLeft.value = 0;
                              actions.PlayerRight.value = 0;
                              actions.PlayerJump.value = 0;

                              this.xVel = 0;
                              this.yVel = 0;
                              this.tex = "zack_death";

                              if (this.deathTicks <= 0)
                              {
                                  this.requestedAlpha = 1;

                                  this.SpawnCoordinates();

                                  this.xVel = 0;
                                  this.yVel = 0;
                                  this.tick = 0;
                                  this.blinking = false;
                                  this.idleTick = 0;

                                  this.respawnTick = 45;
                                  this.tex = "zack_idle";

                                  currentLevelPoints = 0;
                                  
                                  for (let i = 0; i < templates.list.theFlag.length; i++) 
                                  { 
                                      templates.list.theFlag[i].frame = 1;
                                      templates.list.theFlag[i].frameTick = 0;
                                      templates.list.theFlag[i].tex = "theFlag_frame1";
                                  }

                                  for (let i = 0; i < templates.list.coin.length; i++)
                                  {
                                      if (!templates.list.coin[i])
                                          continue;
                                      
                                      templates.list.coin[i].alpha = 1;
                                      templates.list.coin[i].requestedAlpha = 1;
                                      templates.list.coin[i].frame = 1;
                                      templates.list.coin[i].frameTick = 0;
                                      templates.list.coin[i].tex = "coin_frame1"; 
                                  }

                                  if (templates.list.CAMERA)
                                  {
                                      for (let i = 0; i < templates.list.CAMERA.length; i++)
                                      {
                                          if (!templates.list.CAMERA[i]) 
                                              continue;

                                          templates.list.CAMERA[i].x = this.x + (this.width / 2);;
                                          templates.list.CAMERA[i].y = this.y + (this.height / 2);
                                      }
                                  }

                                  for (let i = 0; i < templates.list.cloudBG.length; i++)
                                  {
                                      if (!templates.list.cloudBG[i]) 
                                          continue;

                                      templates.list.cloudBG[i].x = templates.list.cloudBG[i].startX;
                                  }

                                  if (templates.list.target)
                                  {
                                      for (let i = 0; i < templates.list.target.length; i++)
                                      {
                                          if (!templates.list.target[i]) 
                                              continue;

                                          templates.list.target[i].RestartTarget(0);
                                      }
                                  }

                                  StopSFX();

                                  this.resetting = true;
                              }
                          }
                      }


                      if (this.respawnTick > 0 && (!this.deathTicks ||
                      this.deathTicks <= 0))

                      {    
                          if (this.respawnTick > 15)
                          {
                              if ((45 - this.respawnTick) % 10 < 5)
                              {
                                  this.requestedAlpha = 0;
                              }
                              else
                              {
                                  this.requestedAlpha = 1;
                              }
                          }
                          else
                          {
                              this.requestedAlpha = 1;
                          }

                          if (this.allowedToMove)
                              this.respawnTick--;

                          if (this.respawnTick <= 0)
                          {
                              this.requestedAlpha = 1;
                          }
                      }


                      if (this.xVel == undefined)

                      {
                          this.xVel = 0;
                      }


                      if (this.yVel == undefined)

                      {
                          this.yVel = 0;
                      }


                      if (this.verticalVelocity == undefined)

                      {
                          this.verticalVelocity = 5;
                      }


                      if (this.horizontalVelocity == undefined)

                      {
                          this.horizontalVelocity = 5;
                      }


                      if (this.theGravity == undefined)

                      {
                          this.theGravity = 1;
                      }


                      if (this.jumpHeight == undefined)

                      {
                          this.jumpHeight = -20.1;
                      }


                      if (this.collisionTile == undefined)

                      {
                          this.collisionTile = ["grassTile", "dirtTile"];
                      }


                      if (this.onTheGround == undefined)

                      {
                          this.onTheGround = false;
                      }


                      if (this.deathTicks == undefined)

                      {
                          this.deathTicks = 0;
                      }


                      if ((!this.deathTicks || this.deathTicks <= 0) &&
                      !this.resetting && this.allowedToMove)

                      {
                          if (inputEnabled && !currentLevelComplete)
                          {
                              if (actions.PlayerLeft.value && !actions.PlayerRight.value)
                              {
                                  this.xVel = -this.horizontalVelocity;
                              }

                              if (actions.PlayerRight.value && !actions.PlayerLeft.value)
                              {
                                  this.xVel = this.horizontalVelocity;
                              }

                              if (!actions.PlayerLeft.value && !actions.PlayerRight.value)
                              {
                                  this.xVel = 0;
                              }

                              if (actions.PlayerJump.value && this.onTheGround && !this.hitHeadPlayed)
                              {
                                  this.yVel = this.jumpHeight;
                                  
                                  sounds.play("playerJump");
                              }
                          }

                          if (this.yVel <= this.fallSpeedLimit)
                          {
                              this.yVel += this.theGravity;
                          }
                          else
                          {
                              this.yVel = this.fallSpeedLimit;
                          }
                          
                          this.onTheGround = false;

                          if (!currentLevelComplete)
                          {
                              this.x += this.xVel;
                          }

                          for (let i = 0; i < this.collisionTile.length; i++)
                          {
                              if (!templates.list[this.collisionTile[i]])
                              {
                                  continue;
                              }

                              for (let j = 0; j < templates.list[this.collisionTile[i]].length; j++)
                              {
                                  if (!InView(templates.list[this.collisionTile[i]][j]))
                                      continue;

                                  if (this.x < templates.list[this.collisionTile[i]][j].x + templates.list[this.collisionTile[i]][j].width && this.x + this.width > templates.list[this.collisionTile[i]][j].x && this.y < templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height && this.y + this.height > templates.list[this.collisionTile[i]][j].y)
                                  {
                                      if (this.xVel > 0 && this.y + this.height > templates.list[this.collisionTile[i]][j].y + 0.1 && this.y < templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height - 0.1)
                                          this.x = templates.list[this.collisionTile[i]][j].x - this.width;

                                      if (this.xVel < 0 && this.y + this.height > templates.list[this.collisionTile[i]][j].y + 0.1 && this.y < templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height - 0.1)
                                          this.x = templates.list[this.collisionTile[i]][j].x + templates.list[this.collisionTile[i]][j].width;

                                      this.xVel = 0;
                                  }
                              }
                          }

                          if (!currentLevelComplete)
                          {
                              this.y += this.yVel;
                          }
                          
                          for (let i = 0; i < this.collisionTile.length; i++)
                          {
                              if (!templates.list[this.collisionTile[i]])
                              {
                                  continue;
                              }

                              for (let j = 0; j < templates.list[this.collisionTile[i]].length; j++)
                              {
                                  if (templates.list[this.collisionTile[i]][j].x + templates.list[this.collisionTile[i]][j].width < this.x - 192 || templates.list[this.collisionTile[i]][j].x > this.x + this.width + 192 || templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height < this.y - 192 || templates.list[this.collisionTile[i]][j].y > this.y + this.height + 192)
                                      continue;

                                  if (this.x < templates.list[this.collisionTile[i]][j].x + templates.list[this.collisionTile[i]][j].width && this.x + this.width > templates.list[this.collisionTile[i]][j].x && this.y < templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height && this.y + this.height > templates.list[this.collisionTile[i]][j].y)
                                  {
                                      if (this.yVel > 0)
                                      {
                                          this.y = templates.list[this.collisionTile[i]][j].y - this.height;
                                          this.yVel = 0;
                                          this.onTheGround = true;
                                      }

                                      if (this.yVel < 0)
                                      {
                                          if (this.y < templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height && this.y + this.height > templates.list[this.collisionTile[i]][j].y && this.y - this.yVel >= templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height)
                                          {
                                              let prevVel = this.yVel;

                                              this.y = templates.list[this.collisionTile[i]][j].y + templates.list[this.collisionTile[i]][j].height;
                                              this.yVel = 0;

                                              if (prevVel < 0 && !this.hitHeadPlayed && !touchingHazard)
                                              {
                                                  sounds.play("playerHitHead");
                                                  this.hitHeadPlayed = true;
                                              }

                                              if (sounds.playing("playerJump"))
                                              {
                                                  sounds.stop("playerJump");
                                              }
                                          }
                                      }
                                  }
                              }
                          }

                          if (this.yVel != 0 || (this.yVel == 0 && !actions.PlayerJump.value))
                          {
                              this.hitHeadPlayed = false;
                          }
                      }


                      if (this.x < 0)

                      {
                          this.x = 0;
                      }


                      if (this.x > 12224)

                      {
                          this.x = 12224;
                      }


                      if (this.tick == undefined)

                      {
                          this.tick = 0;
                      }


                      if (this.blinking == undefined)

                      {
                          this.blinking = false;
                      }


                      if (this.idleTick == undefined)

                      {
                          this.idleTick = 0;
                      }


                      this.tick++;


                      if (!actions.PlayerLeft.value &&
                      !actions.PlayerRight.value && !actions.PlayerJump.value &&
                      this.yVel == 0 && this.allowedToMove)

                      {
                          this.idleTick++;
                      }

                      else

                      {
                          this.idleTick = 0;
                          this.blinking = false;
                          this.tick = 0;
                      }


                      if (this.tick % 100 == 0 && this.idleTick >= 300)

                      {
                          if (Math.floor(Math.random() * 2) + 1 == 1)
                          {
                              this.blinking = true;
                              this.blinkTimer = 10;
                          }
                      }


                      if (inputEnabled && !currentLevelComplete &&
                      this.allowedToMove)

                      {
                          if (this.deathTicks && this.deathTicks > 0)
                          {
                              this.tex = "zack_death";
                          }
                          else if (this.blinking)
                          {
                              this.tex = "zack_blink";
                              this.blinkTimer--;

                              if (this.blinkTimer <= 0)
                              {
                                  this.blinking = false;
                              }
                          }
                          else
                          {
                              if (!actions.PlayerLeft.value && !actions.PlayerRight.value && this.yVel > 1)
                              {
                                  this.tex = "zack_fall";
                              }

                              if (actions.PlayerLeft.value && this.xVel < 0)
                              {
                                  if (this.yVel < -1)
                                  {
                                      this.tex = "zack_leftJump";
                                  }

                                  if (this.yVel > 1)
                                  {
                                      this.tex = "zack_leftFall";
                                  }

                                  if (this.yVel >= -1 && this.yVel <= 1)
                                  {
                                      this.tex = "zack_leftNormal";
                                  }
                              }

                              if (actions.PlayerRight.value && this.xVel > 0)
                              {
                                  if (this.yVel < -1)
                                  {
                                      this.tex = "zack_rightJump";
                                  }

                                  if (this.yVel > 1)
                                  {
                                      this.tex = "zack_rightFall";
                                  }

                                  if (this.yVel >= -1 && this.yVel <= 1)
                                  {
                                      this.tex = "zack_rightNormal";
                                  }
                              }

                              if (!actions.PlayerLeft.value && !actions.PlayerRight.value)
                              {
                                  if (this.yVel < -1)
                                  {
                                      this.tex = "zack_jump";
                                  }

                                  if (this.yVel > 1)
                                  {
                                      this.tex = "zack_fall";
                                  }

                                  if (this.yVel >= -1 && this.yVel <= 1)
                                  {
                                      this.tex = "zack_idle";
                                  }
                              }
                          }
                      }
                    arguments: {}
                  - eventKey: OnCreate
                    code: |-
                      this.horizontalVelocity = 8;
                      this.alpha = 0;
                      this.requestedAlpha = 1;
                      this.isAlive = true;
                      this.allowedToMove = true;
                      this.zIndex = 0;

                      timesLevelOpened++;
                      currentLevelPoints = 0;
                    arguments: {}
                    lib: core
                  - eventKey: OnDraw
                    code: this.alpha = this.requestedAlpha;
                    arguments: {}
                    lib: core
                extends:
                  cgroup: ''
                  'editor:myCollidingCGroups': []
                  lightTexture@@texture: -1
                  lightColor: '#ffffff'
                  lightOpacity: false
                  lightScale: 0
