  - type: folder
    uid: N25JP8T8JT8qwF
    colorClass: warning
    icon: template
    name: templates
    lastmod: 1772918052663
    entries:
      - type: folder
        uid: 7f2cH58QPhNWFG
        colorClass: error
        icon: folder
        name: user_interface
        lastmod: 1772918186316
        entries:
          - type: template
            baseClass: NineSlicePlane
            name: playButton
            depth: 0
            texture: MpzNNbkc8rDCm8
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnStep
                code: >-
                  if (!this.spriteCreated)

                  {
                      timesMainMenuOpened++;

                      currentLevelComplete = false;
                      this.spriteCreated = true;
                  }


                  // Calculating the distance between the center of the button &
                  the mouse pointer

                  let distance = Math.sqrt(Math.pow((this.x + (this.width / 2) -
                  pointer.x), 2) + Math.pow((this.y + (this.height / 2) -
                  pointer.y), 2));


                  if (distance <= this.width / 2)

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 288, 288);
                      if (pointer.down[0] && pointer.buttons == 1 && inputEnabled)
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 320, 320);

                      if (pointer.released[0] && pointer.buttons == 1 && inputEnabled)
                      {
                          sounds.play("select");

                          if (rooms.current.everything != undefined) // Calling on the MoveCameraDown() function from CAMERA 
                          {
                              for (let i = 0; i < rooms.current.everything.children.length; i++) 
                              {
                                  let obj = rooms.current.everything.children[i] as any;
                                  if (obj.MoveCameraDown != undefined) 
                                  {
                                      obj.movingDownByARoom = true;
                                      break;
                                  }
                              }
                          }

                          inputEnabled = false;
                      }
                  }

                  else

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 256, 256);
                  }
                arguments: {}
                lib: core
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.spriteCreated = false;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1780179542985
            uid: PLnqbNCqPGhPF1
            behaviors: []
            extendTypes: ''
            defaultText: ''
            textStyle: -1
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
            hoverTexture: -1
            pressedTexture: -1
            disabledTexture: -1
          - type: template
            baseClass: NineSlicePlane
            name: logo
            depth: 0
            texture: 8879ML9jL89zKw
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnCreate
                code: |-
                  camera.x = 1921;
                  camera.y = 1081;
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779949832549
            uid: rKRBQ2236BFKMb
            behaviors: []
            extendTypes: ''
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
            defaultText: ''
            textStyle: -1
          - type: template
            baseClass: NineSlicePlane
            name: infoButton
            depth: 0
            texture: T132pLz9Mn155D
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  // Calculating the distance between the center of the button &
                  the mouse pointer

                  let distance = Math.sqrt(Math.pow((this.x + (this.width / 2) -
                  pointer.x), 2) + Math.pow((this.y + (this.height / 2) -
                  pointer.y), 2));


                  if (distance <= this.width / 2)

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 144, 144);
                      if (pointer.down[0] && pointer.buttons == 1 && inputEnabled)
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 160, 160);

                      if (pointer.released[0] && pointer.buttons == 1 && inputEnabled)
                      {
                          sounds.play("select"); // Select SFX plays

                          if (rooms.current.everything != undefined) // Calling on the MoveCameraLeft() function from CAMERA 
                          {
                              for (let i = 0; i < rooms.current.everything.children.length; i++) 
                              {
                                  let obj = rooms.current.everything.children[i] as any;
                                  if (obj.MoveCameraLeft != undefined) 
                                  {
                                      obj.movingLeftByARoom = true;
                                      break;
                                  }
                              }
                          }

                          inputEnabled = false;
                      }
                  }

                  else

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 128, 128);
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779949793706
            uid: 6jrRRj4wtgQnr2
            behaviors: []
            extendTypes: ''
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
          - type: template
            baseClass: AnimatedSprite
            name: startup
            depth: 0
            texture: K1LC8qDGrQqzhP
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  if (pointer.down[0] && pointer.buttons == 1 &&
                  !this.activeAnimation)
                      this.activeAnimation = true;

                  if (this.activeAnimation)
                      this.animationFrame++;

                  if (this.animationFrame < 31)
                      this.alpha = 0;
                  if (this.animationFrame == 31)

                  {
                      this.alpha = 1;
                      if (!volumeIsMuted)
                          sounds.play("startupSound");
                  }

                  if (this.animationFrame > 90)

                  {
                      if (this.alpha > 0)
                          this.alpha -= 0.0125;
                      else
                      {
                          if (this.animationFrame == 201)
                              rooms.switch("MainMenu");
                      }
                  }






                  if (actions.Mute.pressed)
                      MuteUnmute();
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.animationFrame = 0;
                  this.activeAnimation = false;
                  sounds.load("startupSound");
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              alpha: 1
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779937715433
            uid: qLqPjckk2W1b34
            behaviors: []
            extendTypes: ''
            defaultText: ''
            textStyle: -1
            tilingSettings:
              scrollSpeedX: 0
              scrollSpeedY: 0
              pixelPerfect: false
              isUi: false
            repeaterSettings:
              defaultCount: 3
            nineSliceSettings:
              top: 16
              left: 16
              bottom: 16
              right: 16
              autoUpdate: false
          - type: template
            baseClass: Text
            name: startupText
            depth: 0
            texture: -1
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  this.label = new PIXI.BitmapText("Click to start", {align:
                  "center", fontName: "Ithaca", fontSize: 64});

                  this.addChild(this.label);


                  this.label.x -= this.label.width / 2;

                  this.label.y -= this.label.height / 2;


                  if (pointer.down[0] && pointer.buttons == 1 && this.alpha !=
                  0)
                      this.alpha = 0;
                arguments: {}
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
            lastmod: 1779823736602
            uid: 75RG8tHpL8Dptp
            behaviors: []
            extendTypes: ''
            defaultText: ''
            textStyle: -1
          - type: template
            baseClass: AnimatedSprite
            name: CAMERA
            depth: 0
            texture: -1
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                code: >-
                  var zackExists = false;

                  var zack;


                  var character = templates.list["zack"][0];

                  if (templates.valid(character))

                  {
                      zackExists = true;
                      zack = character;
                  }



                  if (zackExists)

                  {
                      this.x = zack.x + (zack.width / 2);
                      this.y = zack.y + (zack.height / 2);
                  }



                  this.animationFrame++;

                  if (this.animationFrame == 1) 

                  {
                      this.radius = 0;
                      this.lens = new PIXI.Graphics();
                      this.lens.x = this.x;
                      this.lens.y = this.y;
                      
                      rooms.current.everything = new PIXI.Container();

                      while (rooms.current.children.length > 0)
                          rooms.current.everything.addChild(rooms.current.children[0]);

                      rooms.current.addChild(rooms.current.everything);

                      rooms.current.everything.mask = this.lens;

                      rooms.current.addChild(this.lens);
                  }


                  if (this.radius == 0)

                  {
                      this.init = true;
                      if (this.init)
                      {
                          rooms.current.alpha = 1;

                          this.radius = 1;
                      }
                  }


                  if (this.radius < Math.sqrt(Math.pow(1920, 2) + Math.pow(1080,
                  2)))
                      this.radius *= 1.25;
                  else

                  {
                      if (!this.clearedLensYet)
                      {
                          this.clearedLensYet = true;
                          inputEnabled = true;
                          rooms.current.everything.mask = null;
                          rooms.current.removeChild(this.lens);
                      }
                  }


                  if (!this.clearedLensYet)

                  {
                      this.lens.clear();
                      this.lens.beginFill(0xffffff);
                      this.lens.drawCircle(0, 0, this.radius);
                      this.lens.endFill();
                  }







                  if (this.movingLeftByARoom)
                      this.MoveCameraLeft();
                      
                  if (this.movingRightByARoom)
                      this.MoveCameraRight();

                  if (this.movingDownByARoom)
                      this.MoveCameraDown();

                  if (this.movingUpByARoom)
                      this.MoveCameraUp();





                  if (actions.Mute.pressed)
                      MuteUnmute();


                  if (typeof globalThis.NGIO !== "undefined" && globalThis.NGIO)

                  {
                      if (globalThis.NGIO.hasUser)
                      {
                          globalThis.NGIO.getConnectionStatus(function(status)
                          {
                              switch (status)
                              {    
                                  case globalThis.NGIO.STATUS_READY:
                                  globalThis.NGIO.getMedal(89935);
                                  globalThis.NGIO.getMedal(90406);
                                  globalThis.NGIO.getMedal(90407);
                                  globalThis.NGIO.getMedal(90408);
                                  break;
                              }
                          });
                      }
                      
                      globalThis.NGIO.keepSessionAlive();
                  }
                arguments: {}
                lib: core
              - eventKey: OnCreate
                code: |-
                  this.init = false;
                  this.animationFrame = 0;
                  camera.drift = 0;
                  camera.teleportTo(this.x, this.y);
                  camera.follow = this;
                  this.clearedLensYet = false;

                  this.movingLeftByARoom = false;
                  this.movingRightByARoom = false;
                  this.movingDownByARoom = false;
                  this.movingUpByARoom = false;

                  // Move the camera left exponentially by 1920 pixels
                  this.MoveCameraLeft = function() 
                  {
                      if (this.targetX == undefined || !this.movingLeftByARoom) 
                      {
                          this.speedFactor = 0.075;
                          this.targetX = this.x - 1920;
                          this.middleX = this.x - 960;
                      }

                      this.x += (this.targetX - this.x) * (this.speedFactor + this.speedFactor * Math.abs(this.x - this.middleX) / 960);

                      if (Math.abs(this.x - this.targetX) < 1) 
                      {
                          this.x = this.targetX;
                          this.targetX = undefined;
                          this.movingLeftByARoom = false;
                          inputEnabled = true;
                      }
                  };

                  // Move the camera right exponentially by 1920 pixels
                  this.MoveCameraRight = function() 
                  {
                      if (this.targetX == undefined || !this.movingRightByARoom) 
                      {
                          this.speedFactor = 0.075;
                          this.targetX = this.x + 1920;
                          this.middleX = this.x + 960;
                      }

                      this.x += (this.targetX - this.x) * (this.speedFactor + this.speedFactor * Math.abs(this.x - this.middleX) / 960);

                      if (Math.abs(this.x - this.targetX) < 1) 
                      {
                          this.x = this.targetX;
                          this.targetX = undefined;
                          this.movingRightByARoom = false;
                          inputEnabled = true;
                      }
                  };

                  // Move the camera down exponentially by 1080 pixels
                  this.MoveCameraDown = function()
                  {
                      if (this.targetY == undefined || !this.movingDownByARoom)
                      {
                          this.speedFactor = 0.075;
                          this.targetY = this.y + 1080;
                          this.middleY = this.y + 540;
                      }

                      this.y += (this.targetY - this.y) * (this.speedFactor + this.speedFactor * Math.abs(this.y - this.middleY) / 540);

                      if (Math.abs(this.y - this.targetY) < 1)
                      {
                          this.y = this.targetY;
                          this.targetY = undefined;
                          this.movingDownByARoom = false;
                          inputEnabled = true;
                      }
                  };

                  // Move the camera up exponentially by 1080 pixels
                  this.MoveCameraUp = function()
                  {
                      if (this.targetY == undefined || !this.movingUpByARoom)
                      {
                          this.speedFactor = 0.075;
                          this.targetY = this.y - 1080;
                          this.middleY = this.y - 540;
                      }

                      this.y += (this.targetY - this.y) * (this.speedFactor + this.speedFactor * Math.abs(this.y - this.middleY) / 540);

                      if (Math.abs(this.y - this.targetY) < 1)
                      {
                          this.y = this.targetY;
                          this.targetY = undefined;
                          this.movingUpByARoom = false;
                          inputEnabled = true;
                      }
                  };
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
