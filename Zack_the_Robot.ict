          - type: template
            baseClass: AnimatedSprite
            name: blackBGText
            depth: 0
            texture: -1
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!this.label)
                  {
                      this.text = "";
                      this.lastText = "";

                      this.label = new PIXI.BitmapText("",
                      {
                          align: "center",
                          fontName: "Ithaca",
                          fontSize: 256
                      });

                      this.addChild(this.label);

                      this.outlines = [];

                      const outline = 16;

                      const offsets =
                      [
                          [-outline, -outline],
                          [0, -outline],
                          [outline, -outline],
                          [outline, 0],
                          [outline, outline],
                          [0, outline],
                          [-outline, outline],
                          [-outline, 0]
                      ];

                      for (let i = 0; i < offsets.length; i++)
                      {
                          const outlineText = new PIXI.BitmapText("",
                          {
                              align: "center",
                              fontName: "Ithaca",
                              fontSize: 256
                          });

                          outlineText.tint = 0x000000;

                          this.addChildAt(outlineText, 0);

                          this.outlines.push(
                          {
                              obj: outlineText,
                              offset: offsets[i]
                          });
                      }
                  }


                  if (this.newText != this.lastText)
                  {
                      this.lastText = this.newText;

                      this.label.text = this.newText;

                      this.label.x = -this.label.width / 2;
                      this.label.y = -this.label.height / 2;

                      for (let i = 0; i < this.outlines.length; i++)
                      {
                          const o = this.outlines[i];

                          o.obj.text = this.newText;

                          o.obj.x = this.label.x + o.offset[0];
                          o.obj.y = this.label.y + o.offset[1];
                      }
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |
                  this.alpha = 0;
                  this.requestedAlpha = 0;
                  this.requestedXOffset = 0;
                  this.requestedYOffset = -384;
                  this.zIndex = 10;
                  this.newText = "";
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: |-
                  this.alpha = this.requestedAlpha;

                  this.x = camera.x - (this.width / 2) + this.requestedXOffset;
                  this.y = camera.y - (this.height / 2) + this.requestedYOffset;
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1780035513890
            uid: MdfnT3LHbb5Jqg
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: AnimatedSprite
            name: press_p_to_pause_text
            depth: 0
            texture: -1
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!this.label)
                  {
                      this.text = "";
                      this.lastText = "";

                      this.label = new PIXI.BitmapText("",
                      {
                          align: "center",
                          fontName: "Ithaca",
                          fontSize: 48
                      });

                      this.addChild(this.label);
                  }

                  this.newText = "Press P to open the pause menu.";

                  if (this.newText != this.lastText)
                  {
                      this.lastText = this.newText;

                      this.label.text = this.newText;

                      this.label.x = -this.label.width / 2;
                      this.label.y = -this.label.height / 2;
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.requestedAlpha = 0.5;
                  this.requestedXOffset = 0;
                  this.requestedYOffset = 480;
                  this.zIndex = 10;
                  this.newText = "";
                  this.animationStopped = false;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: |-
                  if (this.tick == undefined)
                  {
                      this.tick = 0;
                  }

                  if (!this.animationStopped && timesLevelOpened <= 1) 
                  {
                      this.tick++;

                      if (this.tick <= 30 || this.tick > 210)
                      {
                          this.requestedAlpha = 0;
                      }

                      if (this.tick > 30 && this.tick <= 75)
                      {
                          this.requestedAlpha = ((this.tick - 30) / 45) * 0.625;
                      }

                      if (this.tick > 75 && this.tick <= 165)
                      {
                          this.requestedAlpha = 0.625;
                      }

                      if (this.tick > 165 && this.tick <= 210)
                      {
                          this.requestedAlpha = (1 - ((this.tick - 165) / 45)) * 0.625;
                      }
                  }
                  else
                  {
                      this.requestedAlpha = 0;
                  }

                  this.alpha = this.requestedAlpha;

                  this.x = camera.x - (this.width / 2) + this.requestedXOffset;
                  this.y = camera.y - (this.height / 2) + this.requestedYOffset;
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1780018872416
            uid: 7t4kcMRNQDj6FL
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: AnimatedSprite
            name: scoreDisplayInGame
            depth: 0
            texture: -1
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!this.label)
                  {
                      this.text = "";
                      this.lastText = "";

                      this.label = new PIXI.BitmapText("",
                      {
                          align: "left",
                          fontName: "Ithaca",
                          fontSize: 32
                      });

                      this.addChild(this.label);

                      this.outlines = [];

                      const outline = 2;

                      const offsets =
                      [
                          [-outline, -outline],
                          [0, -outline],
                          [outline, -outline],
                          [outline, 0],
                          [outline, outline],
                          [0, outline],
                          [-outline, outline],
                          [-outline, 0]
                      ];

                      for (let i = 0; i < offsets.length; i++)
                      {
                          const outlineText = new PIXI.BitmapText("",
                          {
                              align: "left",
                              fontName: "Ithaca",
                              fontSize: 32
                          });

                          outlineText.tint = 0x000000;

                          this.addChildAt(outlineText, 0);

                          this.outlines.push(
                          {
                              obj: outlineText,
                              offset: offsets[i]
                          });
                      }
                  }

                  var newText = "";

                  if (currentLevelComplete)
                  {
                      newText = "Score: " + levelPointsFinished.toLocaleString();
                  }
                  else
                  {
                      newText = "Score: " + currentLevelPoints.toLocaleString();
                  }

                  if (newText != this.lastText)
                  {
                      this.lastText = newText;

                      this.label.text = newText;

                      this.label.x = 0;
                      this.label.y = 0;

                      for (let i = 0; i < this.outlines.length; i++)
                      {
                          const o = this.outlines[i];

                          o.obj.text = newText;

                          o.obj.x = this.label.x + o.offset[0];
                          o.obj.y = this.label.y + o.offset[1];
                      }
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.requestedAlpha = 1;
                  this.requestedXOffset = 24;
                  this.requestedYOffset = 24;
                  this.zIndex = 11;
                  this.newText = "";
                  this.animationStopped = false;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.tick == undefined)

                  {
                      this.tick = 0;
                  }


                  this.alpha = 1;


                  this.x = camera.x - (camera.width / 2) +
                  this.requestedXOffset;

                  this.y = camera.y - (camera.height / 2) +
                  this.requestedYOffset;
                arguments: {}
                lib: core
            extends:
              cgroup: ''
