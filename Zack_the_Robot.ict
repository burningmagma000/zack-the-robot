              autoUpdate: false
          - type: template
            baseClass: AnimatedSprite
            name: versionText
            depth: 0
            texture: -1
            playAnimationOnStart: true
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!this.label)
                  {
                      this.text = "";
                      this.lastText = "";

                      this.label = new PIXI.BitmapText("",
                      {
                          align: "left",
                          fontName: "Ithaca",
                          fontSize: 32
                      });

                      this.addChild(this.label);

                      this.outlines = [];

                      const outline = 2;

                      const offsets =
                      [
                          [-outline, -outline],
                          [0, -outline],
                          [outline, -outline],
                          [outline, 0],
                          [outline, outline],
                          [0, outline],
                          [-outline, outline],
                          [-outline, 0]
                      ];

                      for (let i = 0; i < offsets.length; i++)
                      {
                          const outlineText = new PIXI.BitmapText("",
                          {
                              align: "left",
                              fontName: "Ithaca",
                              fontSize: 32
                          });

                          outlineText.tint = 0x000000;

                          this.addChildAt(outlineText, 0);

                          this.outlines.push(
                          {
                              obj: outlineText,
                              offset: offsets[i]
                          });
                      }
                  }

                  const newText = "v1.0.1";

                  if (newText != this.lastText)
                  {
                      this.lastText = newText;

                      this.label.text = newText;

                      this.label.x = 0;
                      this.label.y = 0;

                      for (let i = 0; i < this.outlines.length; i++)
                      {
                          const o = this.outlines[i];

                          o.obj.text = newText;

                          o.obj.x = this.label.x + o.offset[0];
                          o.obj.y = this.label.y + o.offset[1];
                      }
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              'editor:myCollidingCGroups': []
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
            lastmod: 1780169727861
            uid: kDRgd2KnrqMQF1
            behaviors: []
            extendTypes: ''
