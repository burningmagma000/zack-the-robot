          - type: template
            baseClass: AnimatedSprite
            name: background
            depth: 0
            texture: 8dzm8NNhN3PkpW
            playAnimationOnStart: false
            loopAnimation: false
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  this.animationFrame++;


                  if (this.offsetX < -512 || this.offsetY > 512) 

                  {
                      this.animationFrame = 1;
                      this.offsetX = 0;
                      this.offsetY = 0;
                  } 

                  else 

                  {
                      this.offsetX -= 1;
                      this.offsetY += 1;
                  }


                  this.x = camera.x - (camera.width / 2) + this.offsetX - 512;

                  this.y = camera.y - (camera.height / 2)  + this.offsetY -
                  1024;
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.initX = camera.x - (this.width / 2);
                  this.initY = camera.y - (this.height / 2) - 1024;
                  this.x = this.initX;
                  this.y = this.initY;
                  this.offsetX = this.x - (camera.x - camera.width / 2);
                  this.offsetY = this.y - (camera.y - camera.height / 2);
                  this.animationFrame = 0;
                  this.zIndex = -10;
                  this.alpha = 0;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: this.alpha = 1;
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779986573240
            uid: RwPPRDzKwWPQNb
            behaviors: []
            extendTypes: ''
          - type: template
            baseClass: Text
            name: copyright
            depth: 0
            texture: -1
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 30
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: |-
                  if (!this.setUp)
                  {
                      this.label = new PIXI.BitmapText("© Elijah Wiencek 2026",
                      {
                          align: "center",
                          fontName: "Ithaca",
                          fontSize: 64
                      });
                      this.addChild(this.label);

                      this.label.x -= this.label.width / 2;
                      this.label.y -= this.label.height / 2;

                      const outline = 4;

                      const offsets =
                      [
                          [-outline, -outline],
                          [0, -outline],
                          [outline, -outline],
                          [outline, 0],
                          [outline, outline],
                          [0, outline],
                          [-outline, outline],
                          [-outline, 0]
                      ];

                      for (let i = 0; i < offsets.length; i++)
                      {
                          const [differenceX, differenceY] = offsets[i];

                          const outlineText = new PIXI.BitmapText("© Elijah Wiencek 2026",
                          {
                              align: "center",
                              fontName: "Ithaca",
                              fontSize: 64
                          });

                          outlineText.tint = 0x000000;
                          outlineText.x = this.label.x + differenceX;
                          outlineText.y = this.label.y + differenceY;

                          this.addChildAt(outlineText, 0);
                      }

                      this.setUp = true;
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.setUp = false;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
              'editor:myCollidingCGroups': []
            lastmod: 1779949785861
            uid: QtRkPPwNMc54ww
            behaviors: []
            extendTypes: ''
            defaultText: ''
            textStyle: -1
          - type: template
            baseClass: NineSlicePlane
            name: backButtonR
            depth: 0
            texture: TTLH1PNtGtzfgr
            playAnimationOnStart: false
            loopAnimation: true
            animationFPS: 60
            visible: true
            events:
              - eventKey: OnStep
                lib: core
                code: >-
                  // Calculating the distance between the center of the button &
                  the mouse pointer

                  let distance = Math.sqrt(Math.pow((this.x + (this.width / 2) -
                  pointer.x), 2) + Math.pow((this.y + (this.height / 2) -
                  pointer.y), 2));


                  if (distance <= this.width / 2)

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 144, 144);
                      if (pointer.down[0] && pointer.buttons == 1 && inputEnabled)
                          Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 160, 160);

                      if (pointer.released[0] && pointer.buttons == 1 && inputEnabled)
                      {
                          sounds.play("select"); // Select SFX plays

                          if (rooms.current.everything != undefined) // Calling on the MoveCameraRight() function from CAMERA 
                          {
                              for (let i = 0; i < rooms.current.everything.children.length; i++) 
                              {
                                  let obj = rooms.current.everything.children[i] as any;
                                  if (obj.MoveCameraRight != undefined) 
                                  {
                                      obj.movingRightByARoom = true;
                                      break;
                                  }
                              }
                          }

                          inputEnabled = false;
                      }
                  }

                  else

                  {
                      Scale(this, this.x + (this.width / 2), this.y + (this.height / 2), 128, 128);
                  }
                arguments: {}
              - eventKey: OnCreate
                code: |-
                  this.alpha = 0;
                  this.zIndex = 1;
                arguments: {}
                lib: core
              - eventKey: OnDraw
                code: >-
                  if (this.x >= camera.x + 960 || this.x + this.width <=
                  camera.x - 960 || this.y >= camera.y + 540 || this.y +
                  this.height <= camera.y - 540)

                  {
                      this.alpha = 0;
                  }

                  else

                  {
                      this.alpha = 1;
                  }
                arguments: {}
                lib: core
            extends:
              cgroup: ''
              lightTexture@@texture: -1
              lightColor: '#ffffff'
              lightOpacity: false
              lightScale: 0
