                extendTypes: ''
              - type: template
                baseClass: AnimatedSprite
                name: target
                depth: 0
                texture: nwM8RD1Fhm12rP
                playAnimationOnStart: true
                loopAnimation: false
                animationFPS: 60
                visible: true
                events:
                  - eventKey: OnCreate
                    code: |-
                      this.alpha = 0;
                      this.requestedAlpha = 0;
                      this.zIndex = 8;
                    arguments: {}
                    lib: core
                  - eventKey: OnDraw
                    code: |-
                      if (this.tick == undefined)
                      {
                          this.tick = -180;
                      }

                      if (this.shotFired == undefined)
                      {
                          this.shotFired = false;
                      }

                      this.RestartTarget = function (i)
                      {
                          this.tick = -180;
                          this.requestedAlpha = 0;
                          this.alpha = 0;
                          this.requestedAlpha = 0;
                          this.zIndex = 8;
                          this.shotFired = false;

                          this.x = templates.list.zack[i].x + templates.list.zack[i].width / 2 - this.width / 2;
                          this.y = templates.list.zack[i].y + templates.list.zack[i].height / 2 - this.height / 2;
                      }

                      for (let i = 0; i < templates.list.zack.length; i++)
                      {
                          if (templates.list.zack[i].respawnTick == 44)
                          {
                              this.RestartTarget(i);
                          }
                      }

                      for (let i = 0; i < templates.list.zack.length; i++)
                      {
                          if (templates.list.zack[i].allowedToMove && inputEnabled && !currentLevelComplete)
                          {
                              this.tick++;

                              if (this.tick < 0)
                              {
                                  this.requestedAlpha = 0;
                                  this.alpha = 0;
                              }

                              if (this.tick >= 0)
                              {
                                  if (this.tick == 0)
                                  {
                                      this.x = templates.list.zack[i].x + templates.list.zack[i].width / 2 - this.width / 2;
                                      this.y = templates.list.zack[i].y + templates.list.zack[i].height / 2 - this.height / 2;
                                  }

                                  if (this.tick == 186 || this.tick == 204 || this.tick == 222 || this.tick == 240 || this.tick == 258 || this.tick == 276 || this.tick == 294 || this.tick == 312)
                                  {
                                      let alarmVolume = 0;

                                      if (this.tick == 186)
                                          alarmVolume = 1 / 8;
                                      if (this.tick == 204)
                                          alarmVolume = 2 / 8;
                                      if (this.tick == 222)
                                          alarmVolume = 3 / 8;
                                      if (this.tick == 240)
                                          alarmVolume = 4 / 8;
                                      if (this.tick == 258)
                                          alarmVolume = 5 / 8;
                                      if (this.tick == 276)
                                          alarmVolume = 6 / 8;
                                      if (this.tick == 294)
                                          alarmVolume = 7 / 8;
                                      if (this.tick == 312)
                                          alarmVolume = 1;

                                      sounds.volume("alarm", sfxVolume * alarmVolume);
                                      sounds.play("alarm", { volume: sfxVolume * alarmVolume} );
                                      sounds.volume("alarm", sfxVolume * alarmVolume);
                                  }
                                  
                                  this.x = this.x + ((templates.list.zack[i].x + templates.list.zack[i].width / 2 - this.width / 2) - this.x) * 0.04375;
                                  this.y = this.y + ((templates.list.zack[i].y + templates.list.zack[i].height / 2 - this.height / 2) - this.y) * 0.04375;

                                  if (this.tick >= 168 && this.tick < 330)
                                  {
                                      this.requestedAlpha = (this.tick - 168) / (330 - 168);
                                  }

                                  if (this.tick >= 330 && this.tick <= 490)
                                  {
                                      if (this.tick % 12 < 4) 
                                          this.tex = "target_frame4"; 
                                      else if (this.tick % 12 < 8) 
                                          this.tex = "target_frame5"; 
                                      else 
                                          this.tex = "target_frame6";
                                  }
                                  else
                                  {
                                      if (this.tick % 12 < 4) 
                                          this.tex = "target_frame1"; 
                                      else if (this.tick % 12 < 8) 
                                          this.tex = "target_frame2"; 
                                      else 
                                          this.tex = "target_frame3";
                                  }

                                  if (this.tick == 330 || this.tick == 348 || this.tick == 366 || this.tick == 384 || this.tick == 402 || this.tick == 420)
                                  {
                                      if (!this.shotFired)
                                      {
                                          sounds.volume("shot", sfxVolume);
                                          sounds.play("shot", { volume: sfxVolume } );
                                          sounds.volume("shot", sfxVolume);
                                      }

                                      if ((((this.x + this.width / 2 - (templates.list.zack[i].x + templates.list.zack[i].width / 2)) * (this.x + this.width / 2 - (templates.list.zack[i].x + templates.list.zack[i].width / 2))) + ((this.y + this.height / 2 - (templates.list.zack[i].y + templates.list.zack[i].height / 2)) * (this.y + this.height / 2 - (templates.list.zack[i].y + templates.list.zack[i].height / 2)))) <= 9216)
                                      {
                                          if (!templates.list.zack[i].deathTicks || templates.list.zack[i].deathTicks <= 0)
                                          {
                                              templates.list.zack[i].deathTicks = 30;
                                              templates.list.zack[i].requestedAlpha = 1;
                                              templates.list.zack[i].tex = "zack_death";
                                              templates.list.zack[i].xVel = 0;
                                              templates.list.zack[i].yVel = 0;

                                              StopSFX();

                                              if (!sounds.playing("playerDeath"))
                                              {
                                                  sounds.play("playerDeath");
                                              }
                                          }
                                      }
                                  }
                                  if (!this.shotFired)
                                  {
                                      if ((this.tick > 330 && this.tick <= 345) || (this.tick > 348 && this.tick <= 363) || (this.tick > 366 && this.tick <= 381) || (this.tick > 384 && this.tick <= 399) || (this.tick > 402 && this.tick <= 417) || (this.tick > 420 && this.tick <= 435))
                                      {
                                          this.requestedAlpha = 1 - ((this.tick - (this.tick > 420 && 420 || this.tick > 402 && 402 || this.tick > 384 && 384 || this.tick > 366 && 366 || this.tick > 348 && 348 || 330)) / 15);
                                      }

                                      if ((this.tick > 345 && this.tick < 348) || (this.tick > 363 && this.tick < 366) || (this.tick > 381 && this.tick < 384) || (this.tick > 399 && this.tick < 402) || (this.tick > 417 && this.tick < 420) || (this.tick > 435 && this.tick < 490))
                                      {
                                          this.requestedAlpha = 0;
                                          if (templates.list.zack[i].deathTicks > 0)
                                              this.shotFired = true;
                                      }
                                  }
                                  if (this.tick >= 490)
                                  {
                                      this.tick = 0;
                                  }
                              }
                          }
                      }

                      this.alpha = this.requestedAlpha;
                    arguments: {}
                    lib: core
                extends:
                  cgroup: ''
                  'editor:myCollidingCGroups': []
